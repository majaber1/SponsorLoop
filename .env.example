# Leave DATABASE_URL empty for built-in demo mode.
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Cloudflare R2 object storage used by /api/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# SponsorLoop Growth Engine.
# These names are SponsorLoop application variables. Actual TikTok API access
# requires an approved TikTok for Business / TikTok One integration.
TIKTOK_API_FOR_BUSINESS_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=
TIKTOK_BUSINESS_MESSAGING_ENABLED=false
# Keep disabled until the approved messaging connector is implemented and QA'd.
GROWTH_AUTOSEND_ENABLED=false

# Optional production integrations.
ESIGN_PROVIDER_URL=
ESIGN_PROVIDER_TOKEN=
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_TOKEN=
